# SPDX-License-Identifier: AGPL-3.0-only
# Names the calling thread, so that /proc/<pid>/task/*/comm tells the server's pools apart: Kotlin/Native starts its
# workers without a name, and every one of them showed as the process's own name.
package = dev.ostrom.server.app.threads
---
#ifndef __APPLE__
#define _GNU_SOURCE
#endif
#include <pthread.h>

/* Names the calling thread (15 characters at most on Linux). Returns 0, or an error number. */
static inline int ostrom_name_thread(const char *name) {
#ifdef __APPLE__
    return pthread_setname_np(name);
#else
    return pthread_setname_np(pthread_self(), name);
#endif
}
