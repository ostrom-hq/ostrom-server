{
  "name": "@ostrom-hq/openapi",
  "version": "0.0.0",
  "description": "The Ostrom server's API: its OpenAPI document (openapi.json) and the TypeScript types generated from it",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ostrom-hq/ostrom-server.git",
    "directory": "api-package"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    },
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "openapi.json",
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "openapi-typescript openapi.json --output dist/index.d.ts --alphabetize --export-type"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
